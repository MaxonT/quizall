# QuizAll backend environment template
# Copy to .env for local development

NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (choose one mode)
# SQLite (default)
SQLITE_PATH=./data/app.db

# PostgreSQL (optional)
# DATABASE_URL=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:4173

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
