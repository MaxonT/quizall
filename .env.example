# Copy to .env at repository root (or backend/.env). Deployment env takes precedence.
NODE_ENV=development
PORT=8080
# Generate your own: openssl rand -hex 32
JWT_SECRET=
# Leave blank for development mock responses; required for real AI calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
SQLITE_PATH=./data/app.db
CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173
FRONTEND_URL=http://localhost:4173
SUBSCRIPTIONS_ENABLED=false
TRIALS_ENABLED=false
# Optional production PostgreSQL; leave unset for SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/quizall
# Optional OAuth; ordinary email/password login works without these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://your-backend.example/api/auth/oauth/callback
# Optional billing (only when SUBSCRIPTIONS_ENABLED=true).
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
