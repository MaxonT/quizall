# QuizAll Backend Environment Variables

# Database (PostgreSQL for production, SQLite for dev)
# DATABASE_URL=postgresql://user:pass@host:5432/quizall
# SQLITE_PATH=./data/app.db

# Authentication
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# Anthropic API (for quiz generation)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
# Optional — defaults to claude-sonnet-4-6 (claude-sonnet-4-20250514 was retired 2026-06-15)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth redirect (use full callback URL OR backend base URL — both accepted)
# OAUTH_REDIRECT_URI=https://quizall-backend-0qr4.onrender.com/api/auth/oauth/callback
# BACKEND_URL=https://quizall-backend-0qr4.onrender.com
# On Render, RENDER_EXTERNAL_URL is auto-set if neither variable above is configured.
# FRONTEND_URL=https://your-frontend.onrender.com

# CORS
CORS_ORIGIN=http://localhost:5173

# Server
PORT=8080
NODE_ENV=development

# Stripe (disabled for now — free tier only)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MODE=test

# Feature Flags
SUBSCRIPTIONS_ENABLED=false
TRIALS_ENABLED=false
